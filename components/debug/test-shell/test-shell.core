CAPI=2:
# SPDX-License-Identifier: Apache-2.0
name: retro-silicon:debug:test-shell:0.1.0
description: UART command engine giving a host framed, CRC-checked access to a core's bus

filesets:
  rtl:
    files:
      - rtl/ts_rx.sv
      - rtl/ts_tx.sv
      - rtl/test_shell.sv
    file_type: systemVerilogSource
    depend:
      - retro-silicon:common:crc32
      - retro-silicon:common:uart

targets:
  # Parameters go on lint only, as in every component core.
  default: &default
    filesets: [rtl]
    toplevel: test_shell
  lint:
    <<: *default
    parameters: [CLKS_PER_BIT, MAX_PAYLOAD_LOG2, IDLE_CLKS]
    default_tool: verilator
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]

parameters:
  CLKS_PER_BIT:
    datatype: int
    default: 18
    paramtype: vlogparam
    description: Clock frequency divided by the baud rate
  MAX_PAYLOAD_LOG2:
    datatype: int
    default: 11
    paramtype: vlogparam
    description: log2 of the largest command payload in bytes
  IDLE_CLKS:
    datatype: int
    default: 270000
    paramtype: vlogparam
    description: Clocks of silence after which a partial command frame is dropped
