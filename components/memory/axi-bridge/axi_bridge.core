CAPI=2:
# SPDX-License-Identifier: Apache-2.0
name: retro-silicon:memory:axi-bridge:0.1.0
description: memory/sdram's byte port onto an AXI master, for memory behind a processor such as the Zynq's DDR

filesets:
  rtl:
    files:
      - rtl/axi_bridge.sv
    file_type: systemVerilogSource

targets:
  default: &default
    filesets: [rtl]
    toplevel: axi_bridge
  lint:
    <<: *default
    default_tool: verilator
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]
    parameters: [AW]

parameters:
  AW:
    datatype: int
    paramtype: vlogparam
    default: 23
    description: The byte port's address width
