CAPI=2:
# SPDX-License-Identifier: Apache-2.0
name: retro-silicon:video:tia:0.1.0
description: Atari TIA (NTSC) video, colour-clock exact; the line, sync, background, playfield, players, missiles, ball and HMOVE so far

filesets:
  rtl:
    files:
      - rtl/tia_player.sv
      - rtl/tia_missile.sv
      - rtl/tia_ball.sv
      - rtl/tia.sv
    file_type: systemVerilogSource

targets:
  default: &default
    filesets: [rtl]
    toplevel: tia
  lint:
    <<: *default
    default_tool: verilator
    parameters: [SAVE_STATE]
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]

parameters:
  SAVE_STATE:
    datatype: bool
    default: true
    paramtype: vlogparam
    description: 0 leaves out the save-state port's logic
