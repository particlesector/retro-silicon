CAPI=2:
# SPDX-License-Identifier: Apache-2.0
name: retro-silicon:system:nes:0.1.0
description: The NES so far - CPU, PPU, APU, DMA, RAM, and a cartridge with PRG RAM and the mappers NROM, UxROM, CNROM, AxROM, MMC1 and MMC3 - under the test shell, with save states; nes_sdram and nes_bram put memory behind it

filesets:
  rtl:
    files:
      - rtl/nes_cart.sv
      - rtl/nes.sv
      - rtl/nes_video.sv
      - rtl/nes_sdram.sv
      - rtl/nes_bram.sv
      - rtl/nes_axi.sv
    file_type: systemVerilogSource
    depend:
      - retro-silicon:common:por
      - retro-silicon:common:clock-enable
      - retro-silicon:common:crc32
      - retro-silicon:common:cdc
      - retro-silicon:debug:test-shell
      - retro-silicon:debug:video-probe
      - retro-silicon:common:save-state
      - retro-silicon:memory:arbiter
      - retro-silicon:memory:sdram
      - retro-silicon:memory:bram
      - retro-silicon:memory:axi-bridge
      - retro-silicon:memory:cache
      - retro-silicon:memory:port-cdc
      - retro-silicon:cpu:6502
      - retro-silicon:video:ppu-2c02
      - retro-silicon:audio:apu-2a03
      - retro-silicon:audio:resampler
      - retro-silicon:video:line-scaler
      - retro-silicon:video:hdmi

targets:
  # Parameters go on lint only, as in every component core.
  default: &default
    filesets: [rtl]
    toplevel: nes
  lint:
    <<: *default
    parameters: [CLKS_PER_BIT]
    default_tool: verilator
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]

parameters:
  CLKS_PER_BIT:
    datatype: int
    default: 18
    paramtype: vlogparam
    description: Clock frequency divided by the baud rate
