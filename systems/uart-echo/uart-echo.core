CAPI=2:
# SPDX-License-Identifier: Apache-2.0
name: retro-silicon:system:uart-echo:0.1.0
description: UART link test that echoes every byte through a 2 KB FIFO

filesets:
  rtl:
    files:
      - rtl/uart_echo.sv
    file_type: systemVerilogSource
    depend:
      - retro-silicon:common:por
      - retro-silicon:common:uart
      - retro-silicon:common:fifo

targets:
  # Parameters go on lint only, as in every component core.
  default: &default
    filesets: [rtl]
    toplevel: uart_echo
  lint:
    <<: *default
    parameters: [CLKS_PER_BIT]
    default_tool: verilator
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]

parameters:
  CLKS_PER_BIT:
    datatype: int
    default: 9
    paramtype: vlogparam
    description: Clock frequency divided by the baud rate (27 MHz / 18 = 1.5 Mbaud)
