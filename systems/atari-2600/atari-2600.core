CAPI=2:
# SPDX-License-Identifier: Apache-2.0
name: retro-silicon:system:atari-2600:0.1.0
description: The Atari 2600 - the 6507, the TIA (picture and sound), the RIOT and the paddles' inputs - with the cartridge outside, and a2600_sys, the system under the test shell, with its picture and sound on HDMI (a2600_video), and a2600_sdram, the same with the cartridge's ROM in an SDRAM

filesets:
  rtl:
    files:
      - rtl/atari2600.sv
      - rtl/a2600_frame.sv
      - rtl/a2600_cart.sv
      - rtl/a2600_video.sv
      - rtl/a2600_sys.sv
      - rtl/a2600_sdram.sv
    file_type: systemVerilogSource
    depend:
      - retro-silicon:cpu:6502
      - retro-silicon:video:tia
      - retro-silicon:io:riot-6532
      - retro-silicon:io:paddles
      - retro-silicon:common:crc32
      - retro-silicon:common:clock-enable
      - retro-silicon:common:por
      - retro-silicon:common:cdc
      - retro-silicon:common:fifo
      - retro-silicon:audio:resampler
      - retro-silicon:video:hdmi
      - retro-silicon:debug:test-shell
      - retro-silicon:memory:sdram

targets:
  default: &default
    filesets: [rtl]
    toplevel: atari2600
  lint:
    <<: *default
    default_tool: verilator
    parameters: [TIA_SCORE_GLITCH]
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]

parameters:
  TIA_SCORE_GLITCH:
    datatype: bool
    default: false
    paramtype: vlogparam
    description: video/tia's SCORE_GLITCH
