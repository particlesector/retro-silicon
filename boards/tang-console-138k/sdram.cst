// SPDX-License-Identifier: Apache-2.0
// The Tang Console 138K with its SDRAM module (two W9825G6KH on one bus):
// pins.cst's clock and UART, and the board's SDRAM0 connector (J9), from
// Sipeed's schematic (Tang_Mega_138K_Console_32001C). DQM0 and DQM1 reach the
// connector's pins 29 and 30 through the board's 0-ohm links.
IO_LOC "clk" V22;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "uart_tx" V19;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;
IO_LOC "uart_rx" G22;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
// SDRAM0 (J9)
IO_LOC "O_sdram_clk" B17;
IO_PORT "O_sdram_clk" IO_TYPE=LVCMOS33;
IO_LOC "O_sdram_cs_n" F21;
IO_PORT "O_sdram_cs_n" IO_TYPE=LVCMOS33;
IO_LOC "O_sdram_ras_n" F16;
IO_PORT "O_sdram_ras_n" IO_TYPE=LVCMOS33;
IO_LOC "O_sdram_cas_n" E17;
IO_PORT "O_sdram_cas_n" IO_TYPE=LVCMOS33;
IO_LOC "O_sdram_wen_n" D16;
IO_PORT "O_sdram_wen_n" IO_TYPE=LVCMOS33;
IO_LOC "O_sdram_ba[0]" F15;
IO_PORT "O_sdram_ba[0]" IO_TYPE=LVCMOS33;
