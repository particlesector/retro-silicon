// SPDX-License-Identifier: Apache-2.0
// uart_echo on the Tang Nano 20K. The UART is on header pins 41/42 (BANK5, 3.3 V;
// shared with the unused LCD connector) to an external 3.3 V USB-serial adapter,
// because the onboard BL616 bridge can't carry sustained streams (see README.md).
// FPGA pin 42 -> adapter RX, adapter TX -> FPGA pin 41.
IO_LOC "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33;
IO_LOC "uart_tx" 42;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;
IO_LOC "uart_rx" 41;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "led[0]" 15;
IO_LOC "led[1]" 16;
IO_LOC "led[2]" 17;
IO_LOC "led[3]" 18;
IO_LOC "led[4]" 19;
IO_LOC "led[5]" 20;
